###############################################################################
# Masalım — environment configuration
#
# Copy to `.env` and fill in what you have. Every external provider ships with a
# complete mock, so the whole application runs end-to-end with this file exactly
# as it is — no credentials required for local development.
#
# Never commit a real `.env`.
###############################################################################

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
# development | staging | production
APP_ENV=development
API_PORT=3000
ADMIN_PORT=3001
# Comma-separated origins allowed to call the API.
CORS_ORIGINS=http://localhost:3001,http://localhost:8081

# --- Database ----------------------------------------------------------------
DATABASE_URL=postgresql://masalim:masalim@localhost:5432/masalim?schema=public
# Prisma needs a throwaway database to diff migrations against.
SHADOW_DATABASE_URL=postgresql://masalim:masalim@localhost:5432/masalim_shadow?schema=public

# --- Redis (BullMQ queues, rate limiting, job pub/sub) ------------------------
REDIS_URL=redis://localhost:6379

# --- Auth --------------------------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-before-any-deployment
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me-before-any-deployment
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# Apple Sign In — https://developer.apple.com/account/resources/identifiers
APPLE_BUNDLE_ID=com.masalim.app
APPLE_SERVICE_ID=
# Google Sign In — https://console.cloud.google.com/apis/credentials
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_WEB_CLIENT_ID=

# --- Object storage ----------------------------------------------------------
# local | s3    (`local` writes to ./.storage and needs no credentials)
STORAGE_PROVIDER=local
STORAGE_BUCKET=masalim-media
STORAGE_REGION=auto
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
# Cloudflare R2: https://<accountid>.r2.cloudflarestorage.com
# MinIO (docker compose): http://localhost:9000
STORAGE_ENDPOINT=
# Public base URL for non-private assets (R2 custom domain / CDN).
STORAGE_PUBLIC_URL=
STORAGE_FORCE_PATH_STYLE=true
SIGNED_URL_TTL_SECONDS=900

# --- AI: story generation ----------------------------------------------------
# mock | anthropic | openai
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_STORY_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_STORY_MODEL=gpt-5

# --- AI: content moderation --------------------------------------------------
# mock | openai   (openai uses omni-moderation-latest plus an LLM safety pass)
MODERATION_PROVIDER=mock
MODERATION_MODEL=omni-moderation-latest

# --- AI: image generation ----------------------------------------------------
# mock | openai
IMAGE_PROVIDER=mock
IMAGE_MODEL=gpt-image-1
# Character consistency uses the generated cover as a reference image.
IMAGE_USE_REFERENCE_IMAGES=true

# --- AI: text to speech (system voices) --------------------------------------
# mock | elevenlabs
TTS_PROVIDER=mock
ELEVENLABS_API_KEY=
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2

# --- AI: parent voice cloning ------------------------------------------------
# mock | elevenlabs
VOICE_CLONE_PROVIDER=mock
# Days a raw parent recording is retained after a successful clone. 0 = delete immediately.
VOICE_RAW_RETENTION_DAYS=30

# --- Payments: physical books ------------------------------------------------
# mock | iyzico
PAYMENT_PROVIDER=mock
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

# --- Subscriptions -----------------------------------------------------------
# mock | revenuecat
SUBSCRIPTION_PROVIDER=mock
REVENUECAT_SECRET_API_KEY=
REVENUECAT_WEBHOOK_AUTH_HEADER=
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# --- Print provider ----------------------------------------------------------
# mock  (no production print partner selected yet; the adapter interface is ready)
PRINT_PROVIDER=mock

# --- Push notifications ------------------------------------------------------
# mock | expo
PUSH_PROVIDER=mock
EXPO_ACCESS_TOKEN=

# --- Analytics ---------------------------------------------------------------
# noop | posthog
ANALYTICS_PROVIDER=noop
POSTHOG_API_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
EXPO_PUBLIC_ANALYTICS_PROVIDER=noop
EXPO_PUBLIC_POSTHOG_API_KEY=

# --- Observability -----------------------------------------------------------
SENTRY_DSN=
EXPO_PUBLIC_SENTRY_DSN=
LOG_LEVEL=debug

# --- Admin panel -------------------------------------------------------------
ADMIN_SESSION_SECRET=dev-only-admin-session-secret-change-me
NEXT_PUBLIC_API_URL=http://localhost:3000
# Seeded administrator for local development.
ADMIN_SEED_EMAIL=admin@masalim.local
ADMIN_SEED_PASSWORD=masalim-admin-dev

# --- Mobile ------------------------------------------------------------------
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_APP_ENV=development

# ---------------------------------------------------------------- Rendering
# Chromium used to render the digital preview and the print-ready PDF.
# Leave unset to use the browser playwright-core downloads for its own build;
# set it when the image already ships one (a container, a CI runner).
CHROMIUM_EXECUTABLE_PATH=
