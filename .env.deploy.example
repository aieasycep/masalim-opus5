# Masalım — deployment configuration.
#
#   cp .env.deploy.example .env.deploy
#
# Four values are genuinely required and the API refuses to boot without them.
# That is deliberate: a deploy missing a JWT secret should fail at start-up, not
# at the first sign-up.
#
# APP_ENV is the setting to understand before anything else.
#
#   staging     — mock providers allowed. Stories come from templates, narration
#                 is a silent file of the right length, illustrations are
#                 placeholders, payment always succeeds. Use this for the first
#                 deploy and for a build you hand someone to click through.
#   production  — the config schema REFUSES to start with any provider left on
#                 mock, and refuses local file storage. There is no way to run
#                 production on fakes by accident, which is the point: a parent
#                 paying for a printed book must not be served by a mock printer.
#
# So a testable deploy is APP_ENV=staging. Moving to production means turning on
# real providers, and the API will tell you exactly which ones are still missing.

# ============================================================ REQUIRED

APP_ENV=staging
NODE_ENV=production

# Hostnames are the compose service names. Change these if you point at managed
# Postgres/Redis instead, which you should for anything holding real data.
POSTGRES_USER=masalim
POSTGRES_PASSWORD=change-me-a-long-random-string
POSTGRES_DB=masalim
DATABASE_URL=postgresql://masalim:change-me-a-long-random-string@postgres:5432/masalim?schema=public

REDIS_URL=redis://redis:6379

# 32 characters minimum, enforced by the config schema. Generate them, do not
# invent them:  openssl rand -base64 48
# Two different secrets: an access token that leaks must not also mint refresh
# tokens. The admin console derives its own signing key from the access secret,
# so there is no third value to forget.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Seconds. Defaults are 15 minutes and 30 days; the short access token is what
# makes a leaked one survivable, and refresh tokens rotate on every use.
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# ============================================================ NETWORK

# Published ports on the host. Put a TLS terminator in front of both.
API_PORT=3000
ADMIN_PORT=3001
MINIO_PORT=9000

# The API's own public origin. Used to build absolute links (payment callbacks,
# deep links), so it must be the externally reachable HTTPS origin rather than
# the container's. It should match what the mobile build was compiled with
# (EXPO_PUBLIC_API_URL) — the app bakes that in and cannot be told otherwise
# afterwards.
API_BASE_URL=https://api.example.com

# Origins allowed to call the API from a browser. The mobile app is not a
# browser and needs no entry here; the operator console talks server-to-server
# inside the compose network and needs none either. Add one only for a real
# browser client.
CORS_ORIGINS=

# ============================================================ STORAGE

# Signed URLs for audio, illustrations and rendered books. The bundled MinIO is
# fine for staging; for production point STORAGE_ENDPOINT at Cloudflare R2 or S3
# and delete the minio services from the compose file. `local` is rejected under
# APP_ENV=production, because files on a container's disk do not survive it.
STORAGE_PROVIDER=s3
STORAGE_BUCKET=masalim-media
STORAGE_REGION=auto
STORAGE_ENDPOINT=http://minio:9000
STORAGE_ACCESS_KEY=masalim
STORAGE_SECRET_KEY=change-me-too
# The origin the *phone* fetches media from, so it must be publicly reachable —
# not the internal endpoint above.
STORAGE_PUBLIC_URL=https://media.example.com
SIGNED_URL_TTL_SECONDS=3600

# ============================================================ PROVIDERS
#
# Every one of these defaults to a mock, which is why APP_ENV=staging above.
# The app is fully usable with all of them unset, so the whole journey can be
# clicked through before a single API key exists. Turn on one provider at a time
# and you always know which one broke.
#
# Under APP_ENV=production every value below must be non-mock, and
# STORAGE_PROVIDER must be s3.

# Story writing. 'anthropic' or 'openai' needs the matching key below.
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Safety classification. Leaving this mock means nothing is really screened, so
# turn it on before any account that is not yours can create a story.
MODERATION_PROVIDER=mock

# Illustrations.
IMAGE_PROVIDER=mock

# Narration and parent-voice cloning. Both ElevenLabs; one key covers them.
TTS_PROVIDER=mock
VOICE_CLONE_PROVIDER=mock
ELEVENLABS_API_KEY=
# How long raw voice-training recordings are kept. Surfaced to the app through
# GET /app/config, so the settings screen quotes whatever is set here — change
# it and the promise shown to parents changes with it.
VOICE_RAW_RETENTION_DAYS=30

# Card payment for printed books.
PAYMENT_PROVIDER=mock
IYZICO_API_KEY=
IYZICO_SECRET_KEY=

# Subscriptions. Store receipts are validated by RevenueCat, so this stays mock
# until there are real store products to validate against. The entitlement id
# must match the one configured in RevenueCat, or every paying account will look
# unsubscribed.
SUBSCRIPTION_PROVIDER=mock
REVENUECAT_ENTITLEMENT_ID=premium
REVENUECAT_SECRET_API_KEY=
REVENUECAT_WEBHOOK_AUTH_HEADER=

# Physical printing. Only a mock exists; a real printer is an integration, not a
# key.
PRINT_PROVIDER=mock

# Push notifications through Expo.
PUSH_PROVIDER=mock
EXPO_ACCESS_TOKEN=

# Product analytics. Off unless both of these are set, and it still sends
# nothing until a parent opts in.
ANALYTICS_PROVIDER=noop
POSTHOG_API_KEY=
POSTHOG_HOST=

# Error reporting.
SENTRY_DSN=

# ============================================================ SOCIAL SIGN-IN
#
# Only needed if you ship the Apple/Google buttons. Email sign-in works without
# any of them.
APPLE_BUNDLE_ID=com.masalim.app
APPLE_SERVICE_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_WEB_CLIENT_ID=

# ============================================================ FIRST OPERATOR
#
# Used once, by `pnpm db:seed`, to create the first AdminUser for the console.
# Refused under NODE_ENV=production if the password is shorter than 16
# characters. Unset both after the first seed.
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=

LOG_LEVEL=info
