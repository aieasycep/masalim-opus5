{
  "name": "@masalim/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "export": "expo export --platform ios --platform android --output-dir dist",
    "build": "expo export --platform ios --platform android --output-dir dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint app src",
    "test": "vitest run",
    "clean": "rm -rf dist .expo .turbo *.tsbuildinfo",
    "eas-build-post-install": "cd ../.. && pnpm exec turbo run build --filter='@masalim/mobile^...'"
  },
  "dependencies": {
    "@expo-google-fonts/fraunces": "^0.4.1",
    "@expo-google-fonts/nunito": "^0.4.1",
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.0.2",
    "@hookform/resolvers": "^3.10.0",
    "@masalim/analytics": "workspace:*",
    "@masalim/api-client": "workspace:*",
    "@masalim/localization": "workspace:*",
    "@masalim/types": "workspace:*",
    "@masalim/ui": "workspace:*",
    "@masalim/validation": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-google-signin/google-signin": "^13.2.0",
    "@shopify/flash-list": "2.0.2",
    "@tanstack/react-query": "^5.64.1",
    "expo": "~54.0.12",
    "expo-apple-authentication": "~8.0.7",
    "expo-application": "~7.0.7",
    "expo-audio": "~1.0.13",
    "expo-constants": "~18.0.9",
    "expo-crypto": "~15.0.7",
    "expo-font": "~14.0.8",
    "expo-image": "~3.0.9",
    "expo-image-picker": "~17.0.8",
    "expo-linear-gradient": "~15.0.7",
    "expo-linking": "~8.0.8",
    "expo-localization": "~17.0.7",
    "expo-notifications": "~0.32.12",
    "expo-router": "~6.0.10",
    "expo-secure-store": "~15.0.7",
    "expo-splash-screen": "~31.0.10",
    "expo-status-bar": "~3.0.8",
    "expo-web-browser": "~15.0.8",
    "react": "19.1.0",
    "react-hook-form": "^7.54.2",
    "react-native": "0.81.4",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.2",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-worklets": "0.8.3",
    "react-native-screens": "~4.16.0",
    "react-native-webview": "13.15.0",
    "zod": "^3.24.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@masalim/config": "workspace:*",
    "@types/react": "~19.1.0",
    "eslint": "^9.18.0",
    "react-dom": "19.1.0",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
